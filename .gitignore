# ============================================================
# Gamex — .gitignore
# Один файл в корне покрывает front/ (HTML/CSS/JS) и будущий back/ (Rust)
# ============================================================

# ------------------------------------------------------------
# 1. СЕКРЕТЫ И ЛОКАЛЬНЫЕ КОНФИГИ (самое важное!)
# ------------------------------------------------------------
.env
.env.*
!.env.example          # шаблон без секретов — коммитим
*.env
.env.local
.env.development
.env.production

# ключи, сертификаты, приватные данные
*.pem
*.key
*.p12
*.pfx
*.crt
secrets/
credentials/
config/local.*
local.*

# IDE / OS могут создать свои конфиги с путями/токенами
.vscode/settings.json
.idea/workspace.xml

# ------------------------------------------------------------
# 2. RUST / CARGO (back/)
# ------------------------------------------------------------
# артефакты сборки — гигабайты, не коммитим
/target/
**/target/
**/target/debug/
**/target/release/

# Cargo.lock — для бинарников КОММИТИМ (воспроизводимость),
# для библиотек — не коммитим. У тебя бэкенд = бинарник → НЕ игнорируем.
# Если станешь делать библиотеку — раскомментируй:
# Cargo.lock

# временные файлы cargo
**/*.rs.bk
*.pdb

# профилирование / бенчмарки
**/flamegraph.svg
**/perf.data*
**/*.profraw
**/*.profdata

# ------------------------------------------------------------
# 3. NODE / NPM (если появится front-сборка, tailwind, vite)
# ------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.pnpm-store/
.yarn/

# сборки
dist/
build/
.cache/
.parcel-cache/
.vite/
.next/
.nuxt/

# ------------------------------------------------------------
# 4. PYTHON (если появятся скрипты деплоя / генераторы)
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------
# 5. ОС
# ------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.directory
.Trash-*

# ------------------------------------------------------------
# 6. РЕДАКТОРЫ / IDE
# ------------------------------------------------------------
# VS Code — игнорируем всё, кроме recommended extensions и launch
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json.example

# JetBrains (RustRover, IntelliJ, CLion, WebStorm)
.idea/
*.iml
*.iws
*.ipr

# Vim / Emacs
*.swp
*.swo
*~
\#*\#
.\#*

# Sublime
*.sublime-workspace

# ------------------------------------------------------------
# 7. ЛОГИ И ВРЕМЕННЫЕ ФАЙЛЫ
# ------------------------------------------------------------
*.log
logs/
*.tmp
*.temp
*.bak
*.orig
*.rej

# coverage / тесты
coverage/
*.lcov
tarpaulin-report.*

# ------------------------------------------------------------
# 8. ПРОЕКТНЫЕ АРТЕФАКТЫ (на случай экспериментов)
# ------------------------------------------------------------
# дампы БД
*.sqlite
*.sqlite3
*.db
*.dump

# скриншоты в процессе (не путать с финальными в /screenshots)
*.psd
*.ai
*.sketch

# архивы (если локально что-то распаковал)
*.zip
*.tar
*.tar.gz
*.7z
*.rar
!front/icon/*.zip